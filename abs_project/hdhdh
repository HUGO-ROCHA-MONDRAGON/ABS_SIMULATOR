import pandas as pd

# ============================================================
# Holding time "historique" à partir de trades uniquement
#
# Règles demandées :
# 1) On ne garde QUE les lots "clos" :
#    - clos par SELL (matching FIFO)
#    - OU, s'il reste de l'open après les SELL, on le clôture à Expected Maturity
# 2) Si un ISIN a des BUY mais pas de SELL ET pas de Expected Maturity => on IGNORE (on ne l'invente pas)
# 3) Pour détecter "BUY/Sell annulé" et faire le matching, on utilise UNIQUEMENT la QUANTITY (notional),
#    pas de prix/factor.
#
# Convention :
#   - Quantity > 0 => BUY
#   - Quantity < 0 => SELL
#   (si tu as déjà Side, on s'en fout ici)
# ============================================================

FILE = "portfolio.xlsx"
OUTPUT = r"C:\Users\h24826\Desktop\holding_time_realized_qty.xlsx"

trades = pd.read_excel(FILE, sheet_name="trades")
trades.columns = trades.columns.str.strip()

required = {"ISIN", "Trade Date", "Quantity", "Expected Maturity Date"}
missing = required - set(trades.columns)
if missing:
    raise ValueError(f"Missing columns in trades sheet: {missing}")

trades["ISIN"] = trades["ISIN"].astype(str).str.strip()
trades["Trade Date"] = pd.to_datetime(trades["Trade Date"], errors="coerce")
trades["Expected Maturity Date"] = pd.to_datetime(trades["Expected Maturity Date"], errors="coerce")
trades["Quantity"] = pd.to_numeric(trades["Quantity"], errors="coerce")

if trades["Trade Date"].isna().any():
    bad = trades[trades["Trade Date"].isna()]
    raise ValueError("Unparsable Trade Date. Examples:\n" + bad.head(20).to_string(index=False))

if trades["Quantity"].isna().any():
    bad = trades[trades["Quantity"].isna()]
    raise ValueError("Non-numeric Quantity. Examples:\n" + bad[["ISIN", "Trade Date", "Quantity"]].head(20).to_string(index=False))

# Drop zero quantities (no-op)
trades = trades[trades["Quantity"].abs() > 0].copy()

closed_lots = []
ignored_isins = []

def fifo_close_by_qty(lots, sell_qty, sell_date, isin):
    """
    Close sell_qty against FIFO buy lots using quantity only.
    lots: list of dicts {qty, buy_date}
    Records each matched closure as a "lot close".
    Returns remaining sell_qty if oversold.
    """
    remaining = sell_qty

    while remaining > 1e-12 and lots:
        lot = lots[0]
        q = lot["qty"]
        buy_date = lot["buy_date"]

        use = min(q, remaining)

        closed_lots.append({
            "ISIN": isin,
            "BuyDate": buy_date,
            "ExitDate": sell_date,
            "ClosedQty": use,
            "HoldingDays": int((sell_date - buy_date).days),
            "ExitType": "SELL"
        })

        lot["qty"] -= use
        remaining -= use

        if lot["qty"] <= 1e-12:
            lots.pop(0)

    return remaining

def close_remaining_at_maturity(lots, maturity_date, isin):
    for lot in lots:
        closed_lots.append({
            "ISIN": isin,
            "BuyDate": lot["buy_date"],
            "ExitDate": maturity_date,
            "ClosedQty": lot["qty"],
            "HoldingDays": int((maturity_date - lot["buy_date"]).days),
            "ExitType": "MATURITY"
        })

# Process each ISIN
for isin, t in trades.groupby("ISIN"):
    t = t.sort_values("Trade Date")

    # FIFO lots from BUY quantities
    lots = []

    # maturity date (if any)
    mat = t["Expected Maturity Date"].dropna()
    maturity_date = mat.min() if len(mat) else None

    has_buy = (t["Quantity"] > 0).any()
    has_sell = (t["Quantity"] < 0).any()

    # If there is no BUY, skip (nothing to measure)
    if not has_buy:
        continue

    for _, row in t.iterrows():
        q = float(row["Quantity"])
        d = row["Trade Date"]

        if q > 0:  # BUY
            lots.append({"qty": q, "buy_date": d})

        elif q < 0:  # SELL
            sell_qty = abs(q)
            leftover = fifo_close_by_qty(lots, sell_qty, d, isin)

            if leftover > 1e-6:
                # Oversell: inconsistent history. We record it but it won't be used in stats.
                closed_lots.append({
                    "ISIN": isin,
                    "BuyDate": None,
                    "ExitDate": d,
                    "ClosedQty": leftover,
                    "HoldingDays": None,
                    "ExitType": "OVERSELL"
                })

    # Remaining open lots
    if lots:
        # Rule requested:
        # - If no SELL and no Expected Maturity -> ignore entirely
        # - More generally, if maturity missing for remaining open -> ignore remaining open
        if maturity_date is None:
            # Ignore open lots (can't close)
            ignored_isins.append({
                "ISIN": isin,
                "Reason": "OPEN_WITHOUT_MATURITY",
                "OpenQty": sum(l["qty"] for l in lots),
                "FirstBuy": t.loc[t["Quantity"] > 0, "Trade Date"].min(),
                "LastTrade": t["Trade Date"].max()
            })
            continue

        # Close remaining at maturity
        close_remaining_at_maturity(lots, maturity_date, isin)

# Build output tables
closed_df = pd.DataFrame(closed_lots)
ignored_df = pd.DataFrame(ignored_isins)

# Stats on valid closings only
valid = closed_df[closed_df["ExitType"].isin(["SELL", "MATURITY"])].dropna(subset=["HoldingDays"]).copy()

avg_days = valid["HoldingDays"].mean()
median_days = valid["HoldingDays"].median()
qty_wavg_days = (valid["ClosedQty"] * valid["HoldingDays"]).sum() / valid["ClosedQty"].sum()

summary = pd.DataFrame({
    "Metric": [
        "Average holding days (simple, lots)",
        "Median holding days (lots)",
        "Average holding days (qty-weighted)"
    ],
    "Value (days)": [avg_days, median_days, qty_wavg_days],
    "Value (years)": [avg_days/365, median_days/365, qty_wavg_days/365]
})

print("==============================================")
print(summary.to_string(index=False))
print("==============================================")

print("\n[CHECK] ExitType counts:")
print(closed_df["ExitType"].value_counts(dropna=False).to_string())

print("\n[CHECK] Ignored open positions without maturity:", len(ignored_df))
if len(ignored_df):
    print(ignored_df.head(20).to_string(index=False))

# Export (no xlsxwriter required)
with pd.ExcelWriter(OUTPUT) as writer:
    closed_df.sort_values(["ISIN", "ExitDate", "BuyDate"]).to_excel(writer, sheet_name="ClosedLots", index=False)
    summary.to_excel(writer, sheet_name="Summary", index=False)
    ignored_df.to_excel(writer, sheet_name="Ignored", index=False)

print(f"\nExported to: {OUTPUT}")